# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Database Configuration (MongoDB Atlas)
# Replace with your MongoDB Atlas cluster URI when ready:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/product_catalogue?retryWrites=true&w=majority
MONGODB_URI=

# Fake Store API (External Data Source)
FAKESTORE_API_URL=https://fakestoreapi.com

# Notification / Email Configuration
# Optional: real SMTP credentials (SES, SendGrid, Gmail, Ethereal)
# If left empty, the Notification Service falls back gracefully to Mock/Console Logger
# fulfilling constraint #6 (no paid accounts required for reviewer)
SALES_INBOX_EMAIL=sales@officeworks-workplace.com.au
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

