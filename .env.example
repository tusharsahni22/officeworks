# ========================================================
# Officeworks // Workplace MVP - Environment Configuration
# ========================================================

# Application Runtime
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=*

# Docker Hub Image Tag (Default: latest)
TAG=latest
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# MongoDB Database (Optional - falls back to in-memory catalogue)
MONGODB_URI=

# Fake Store API (External Data Source)
FAKESTORE_API_URL=https://fakestoreapi.com

# Commercial Sales Inbox & SMTP (Optional - falls back to console audit log)
SALES_INBOX_EMAIL=sales@officeworks-workplace.com.au
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Contentful Headless CMS (Server-Driven UI)
# If left empty, system gracefully defaults to built-in structured layouts
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_MANAGEMENT_TOKEN=

